# General
APP_ENV=development
LOG_LEVEL=info

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Browser automation
CAMOUFOX_ENABLED=false
CAMOUFOX_HEADLESS=true
CAMOUFOX_PROFILE_DIR=.local/camoufox-profile

# Agent runtime
AGENTS_ENABLED=true
AGENT_PROVIDER=stub
OPENAI_API_KEY=

# Safety controls
AUTHORIZED_USE_ONLY=true
REQUIRE_SCOPE_CONFIRMATION=true
ALLOW_EXTERNAL_TARGETS=false
AUDIT_LOG_DIR=.local/audit-logs
